PROJECT_NAME="인스타그램 클론 API"
# development | production  (production: 안전한 SECRET_KEY가 없으면 서버가 시작되지 않음)
ENVIRONMENT="development"
# Swagger /docs, /redoc, /openapi.json 노출 여부 (운영에서는 false 권장)
DOCS_ENABLED=true
# 운영: 재배포해도 지워지지 않는 위치의 절대 경로 사용 (예: sqlite:////var/lib/instagram/instagram.db)
DATABASE_URL="sqlite:///./instagram.db"
SECRET_KEY="change-me-to-a-long-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR="./static/uploads"
# 만료된 스토리(DB 행 + 이미지 파일) 정리 주기
STORY_PURGE_INTERVAL_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
