{
  "name": "instagram-clone",
  "private": true,
  "description": "Instagram clone (React + FastAPI + SQLite) - run everything with `npm run dev`",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File run.ps1 -Reload",
